{
  "name": "evalation-plugin",
  "version": "0.1.2",
  "description": "The thin client for Evalation, an autonomous software engineering engine. Entitlement, server-injected operating instructions, and auth glue only; all methodology runs server-side.",
  "author": {
    "name": "Evalation",
    "url": "https://evalation.ai"
  },
  "homepage": "https://evalation.ai",
  "license": "SEE LICENSE IN README.md",
  "commands": "./commands",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-guidance.sh"
          }
        ]
      }
    ]
  }
}
